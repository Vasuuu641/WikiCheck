# Copy to .env (git-ignored) and fill the keys. One file for the whole app. Never commit .env.

# --- MariaDB 11.7+ (vector search and system versioning). 3306 = a local server; 3307 = make db-docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wikirag
DB_USER=wikirag
DB_PASSWORD=wikirag
DB_ROOT_PASSWORD=root

# --- Embeddings: Ollama with bge-m3, the model of the stored vectors (make ollama starts it).
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# --- Gemini (https://aistudio.google.com/apikey): cross-language checks, drift, Decisions API.
GEMINI_API_KEY=
# Model names have defaults in api/llm.py; set these only to try another model.
# CHECK_MODEL=gemini-3.5-flash-lite    cross-language checks: run on every page, keep it fast
# WRITE_MODEL=gemini-3.8-flash         drift: writes the claims and the summary
# GEMINI_THINKING=low

# --- Ask: the answer LLM, any OpenAI-compatible endpoint (we use Verda: https://inference.verda.com/v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# none|low|medium|high (none = no hidden reasoning, fastest); empty = don't send the option
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=300

# --- Ask: the neutrality review, OpenAI-compatible. Gemini:
#   NEUTRALITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   NEUTRALITY_MODEL=gemini-3.8-flash   NEUTRALITY_REASONING_EFFORT=none
# Leave any of the three empty to review with the answer LLM.
NEUTRALITY_BASE_URL=
NEUTRALITY_API_KEY=
NEUTRALITY_MODEL=
NEUTRALITY_REASONING_EFFORT=
# The answer waits at most this long (from the start of the request) for the review.
REVIEW_TIMEOUT_S=30

# --- Ask: retrieval. article = nearest articles, then their paragraphs; fusion = reciprocal rank
# fusion with the nearest paragraphs (eval/build_chunks.py fills them; hit@5 78% vs 76%).
RETRIEVAL=article
# 1 = rewrite the question into up to 3 Finnish search queries first (eval: hit@5 76% -> 95%).
QUERY_REWRITE=1
# 0 = /api/ask never writes ask_chunk (set 0 while eval/build_chunks.py runs).
CHUNK_WRITE=1

# --- Optional. Drift reads dataset M from pacome/data/m (make demo-data downloads it).
# HISTORY_DIR=pacome/data/m
# Embeddings on a rented Verda GPU (scripts/verda.py up, then tunnel), billed per hour:
# OLLAMA_URL=http://localhost:11435
# VERDA_CLIENT_ID=
# VERDA_CLIENT_SECRET=
