DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=wikirag
DB_USER=wikirag
DB_PASSWORD=wikirag
DB_ROOT_PASSWORD=root

# Embeddings for questions: must be the same model as the stored vectors (bge-m3, 1024 dims)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# LLM for answers/summaries (optional until the Ask step). Never commit real keys.
GEMINI_API_KEY=

# 1 = API serves files from mocks/, 0 = real database
MOCK=1
