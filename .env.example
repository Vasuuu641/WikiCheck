DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=wikirag
DB_USER=wikirag
DB_PASSWORD=wikirag
DB_ROOT_PASSWORD=root

# Embeddings for questions: must be the same model as the stored vectors (bge-m3, 1024 dims)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# LLM for answers/summaries (optional until the Ask step). Never commit real keys.
GEMINI_API_KEY=

# 1 = API serves files from mocks/, 0 = real database
MOCK=1

# LLM for /api/ask, any OpenAI-compatible endpoint (e.g. Verda: https://inference.verda.com/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: none|low|medium|high (default none = no hidden reasoning, fastest); empty = don't send
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=300

# /api/ask retrieval: article (nearest articles, then their paragraphs; MariaDB's default),
# chunk (nearest paragraphs from chunk_vector; fill it first with eval/build_chunks.py), or
# fusion (articles by reciprocal rank fusion of both lists, then paragraphs as article; best on
# eval/run_eval.py: hit@5 78% vs 76%). Without chunks, fusion ranks like article. as_of always uses article.
RETRIEVAL=fusion
# 0 = /api/ask never writes chunk / chunk_vector (set 0 while eval/build_chunks.py runs). Default 1.
CHUNK_WRITE=1

# Neutrality review (api/review.py), an OpenAI-compatible endpoint. Gemini:
#   NEUTRALITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   NEUTRALITY_MODEL=gemini-2.5-flash   NEUTRALITY_REASONING_EFFORT=none
# Leave any of the three empty to review with the main LLM (LLM_*). Never commit the key.
NEUTRALITY_BASE_URL=
NEUTRALITY_API_KEY=
NEUTRALITY_MODEL=
NEUTRALITY_REASONING_EFFORT=
# The answer waits at most this long (from the start of the request) for the review.
REVIEW_TIMEOUT_S=30

# 1 = before retrieval, one short call to the review model (NEUTRALITY_*, else LLM_*) rewrites
# the question into up to 3 Finnish search queries (historical names, synonyms, one per likely
# event); the lists are merged by reciprocal rank fusion. 0 = search with the question only.
QUERY_REWRITE=1
